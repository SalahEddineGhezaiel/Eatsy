@inherits LayoutComponentBase
<div class="page d-flex flex-column min-vh-100">
    <header class="top-bar-shadow">
        <NavMenu />
    </header>
    
    <main class="flex-grow-1" style="padding-bottom: 60px;">
        <article class="content px-4 py-4">
            @Body
        </article>
    </main>

    <footer class="text-center py-3 mt-auto" 
            style="background-color: var(--eatsy-dark); color: var(--eatsy-light); font-size: 0.85rem; position: fixed; bottom: 0; width: 100%; z-index: 1030;">
        Eatsy 🍽️ — Gestion de recettes & nutrition
    </footer>
</div>
<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
<RadzenComponents />
<RadzenNotification />